PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX rev: <http://purl.org/stuff/rev#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX fs: <http://fedshop.example.org/vocab#>

# FedShop q12: an offer at my shop with its vendor, and the product's label from its brand.
# kind: lookup
# rows: 1-1
# discovered: 1
SELECT DISTINCT ?product ?productlabel ?vendorname ?vendorhomepage ?offerURL ?price ?deliveryDays ?validTo WHERE {
    SERVICE <{{Shop}}> {
        <{{Offer}}> bsbm:product ?listing .
        ?listing fs:listingOf ?product .
        <{{Offer}}> bsbm:vendor ?vendorURI .
        ?vendorURI rdfs:label ?vendorname .
        ?vendorURI foaf:homepage ?vendorhomepage .
        <{{Offer}}> bsbm:offerWebpage ?offerURL .
        <{{Offer}}> bsbm:price ?price .
        <{{Offer}}> bsbm:deliveryDays ?deliveryDays .
        <{{Offer}}> bsbm:validTo ?validTo .
    }
    ?product rdfs:label ?productlabel .
}
