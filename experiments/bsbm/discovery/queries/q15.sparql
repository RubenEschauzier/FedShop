PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX rev: <http://purl.org/stuff/rev#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX fs: <http://fedshop.example.org/vocab#>

# Reviews of a product by reviewers from the country of a vendor offering it at my shop.
# kind: product
# rows: 2-40
# discovered: 3
SELECT DISTINCT ?vendor ?review ?reviewerName ?country WHERE {
    SERVICE <{{Shop}}> {
        ?listing fs:listingOf <{{Product}}> .
        ?offer bsbm:product ?listing .
        ?offer bsbm:vendor ?vendor .
        ?vendor bsbm:country ?country .
    }
    ?page fs:listingOf <{{Product}}> .
    ?review bsbm:reviewFor ?page .
    ?review rev:reviewer ?reviewer .
    ?reviewer bsbm:country ?country .
    ?reviewer foaf:name ?reviewerName .
}
