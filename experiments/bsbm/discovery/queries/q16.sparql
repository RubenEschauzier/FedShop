PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX rev: <http://purl.org/stuff/rev#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX fs: <http://fedshop.example.org/vocab#>

# Top-rated products of a type that my shop offers: their well-rated reviews at any review site.
# kind: analytical
# rows: 10-200
# discovered: 3
SELECT DISTINCT ?product ?price ?review ?rating1 WHERE {
    SERVICE <{{Shop}}> {
        ?listing fs:listingOf ?product .
        ?offer bsbm:product ?listing .
        ?offer bsbm:price ?price .
    }
    ?product rdf:type <{{ProductType}}> .
    ?page fs:listingOf ?product .
    ?review bsbm:reviewFor ?page .
    ?review bsbm:rating1 ?rating1 .
    FILTER (?rating1 >= {{r}})
}
