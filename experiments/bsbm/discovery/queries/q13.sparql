PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX rev: <http://purl.org/stuff/rev#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX fs: <http://fedshop.example.org/vocab#>

# The rest of a brand's range: its other products, with their offers at any shop.
# kind: analytical
# rows: 20-400
# discovered: 3
SELECT DISTINCT ?product ?label ?offer ?price WHERE {
    <{{Product}}> bsbm:producer ?producer .
    ?product bsbm:producer ?producer .
    FILTER (?product != <{{Product}}>)
    ?product rdfs:label ?label .
    ?listing fs:listingOf ?product .
    ?offer bsbm:product ?listing .
    ?offer bsbm:price ?price .
}
