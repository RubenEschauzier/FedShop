PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX rev: <http://purl.org/stuff/rev#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX fs: <http://fedshop.example.org/vocab#>

# FedShop q07: a product page: my shop's offers for a product, its label, and its reviews at every review site with reviewer names.
# kind: product
# rows: 10-150
# discovered: 3
SELECT DISTINCT ?productLabel ?offer ?price ?review ?revTitle ?revName ?rating1 WHERE {
    SERVICE <{{Shop}}> {
        ?offerListing fs:listingOf <{{Product}}> .
        ?offer bsbm:product ?offerListing .
        ?offer bsbm:price ?price .
    }
    <{{Product}}> rdfs:label ?productLabel .
    ?reviewPage fs:listingOf <{{Product}}> .
    ?review bsbm:reviewFor ?reviewPage .
    ?review dc:title ?revTitle .
    ?review rev:reviewer ?reviewer .
    ?reviewer foaf:name ?revName .
    OPTIONAL { ?review bsbm:rating1 ?rating1 . }
}
