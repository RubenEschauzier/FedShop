PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX rev: <http://purl.org/stuff/rev#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX fs: <http://fedshop.example.org/vocab#>

# FedShop q07: a product page: its label, its offers from vendors in the US still valid at a date (my shop is one), and its reviews with reviewer names.
# kind: product
# rows: 10-150
# discovered: 3
SELECT DISTINCT ?productLabel ?offer ?price ?vendor ?vendorTitle ?review ?revTitle ?reviewer ?revName ?rating1 ?rating2 WHERE {
    <{{Product}}> rdf:type bsbm:Product .
    <{{Product}}> rdfs:label ?productLabel .

    OPTIONAL {
        SERVICE <{{Shop}}> {
            ?offer bsbm:product ?offerListing .
            ?offerListing fs:listingOf <{{Product}}> .
            ?offer bsbm:price ?price .
            ?offer bsbm:vendor ?vendor .
            ?vendor rdfs:label ?vendorTitle .
            ?vendor bsbm:country <{{Country}}> .
            ?offer bsbm:validTo ?date .
            FILTER (?date > "{{currentDate}}"^^xsd:dateTime)
        }
    }
    OPTIONAL {
        ?review bsbm:reviewFor ?reviewPage .
        ?reviewPage fs:listingOf <{{Product}}> .
        ?review rev:reviewer ?reviewer .
        ?reviewer foaf:name ?revName .
        ?review dc:title ?revTitle .
        OPTIONAL { ?review bsbm:rating1 ?rating1 . }
        OPTIONAL { ?review bsbm:rating2 ?rating2 . }
    }
}
