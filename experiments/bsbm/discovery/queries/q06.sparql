PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX rev: <http://purl.org/stuff/rev#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX fs: <http://fedshop.example.org/vocab#>

# FedShop q06: products whose label contains a word.
# Here: among the products some shop sells.
SELECT DISTINCT ?product ?label WHERE {
    ?product rdf:type bsbm:Product .
    ?product rdfs:label ?label .
    FILTER regex(?label, "{{word}}")
    ?listing fs:listingOf ?product .
    ?offer bsbm:product ?listing .
}
