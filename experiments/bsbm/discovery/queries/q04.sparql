PREFIX bsbm: <http://www4.wiwiss.fu-berlin.de/bizer/bsbm/v01/vocabulary/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX rev: <http://purl.org/stuff/rev#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX fs: <http://fedshop.example.org/vocab#>

# FedShop q04: products matching either of two feature combinations.
# Here: among the products some shop sells.
SELECT DISTINCT ?product ?label ?propertyTextual WHERE {
    {
    ?product rdfs:label ?label .
    ?product rdf:type <{{ProductType}}> .
    ?product bsbm:productFeature <{{ProductFeature1}}> .
    ?product bsbm:productFeature <{{ProductFeature2}}> .
    ?product bsbm:productPropertyTextual1 ?propertyTextual .
    ?product bsbm:productPropertyNumeric1 ?p1 .
    FILTER (?p1 > {{x}})
    } UNION {
    ?product rdfs:label ?label .
    ?product rdf:type <{{ProductType}}> .
    ?product bsbm:productFeature <{{ProductFeature1}}> .
    ?product bsbm:productFeature <{{ProductFeature3}}> .
    ?product bsbm:productPropertyTextual1 ?propertyTextual .
    ?product bsbm:productPropertyNumeric2 ?p2 .
    FILTER (?p2 > {{y}})
    }
    ?listing fs:listingOf ?product .
    ?offer bsbm:product ?listing .
}
ORDER BY ?label
