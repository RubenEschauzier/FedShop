# The discovery-based FedShop generator, and the Solid server and proxy that serve its output.
# Built from this checkout (the context is the repository root), for the jbr experiment
# (@rubeneschauzier/fedshop-discovery), which uses the published image by digest:
#
#   docker build -f experiments/bsbm/discovery/docker/Dockerfile-generator -t <registry>/fedshop-discovery-generator:<version> .
#
# Dockerfile-generator.dockerignore lets in only what the generator needs.

FROM node:20.18.0-bookworm-slim AS node
FROM ghcr.io/astral-sh/uv:0.13.6 AS uv

FROM python:3.8.20-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates build-essential libboost-all-dev wamerican wbritish \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm
COPY --from=uv /uv /usr/local/bin/uv

# WatDiv at the commit the generators/watdiv submodule pins
ARG WATDIV_REPOSITORY=https://github.com/mhoangvslev/watdiv.git
ARG WATDIV_COMMIT=6d88a2e6974f0159012791c8a721a58889d7e5bf
RUN git clone "$WATDIV_REPOSITORY" /fedshop/generators/watdiv && git -C /fedshop/generators/watdiv checkout "$WATDIV_COMMIT"
WORKDIR /fedshop
COPY scripts/build-watdiv.sh scripts/
RUN scripts/build-watdiv.sh

ENV UV_PYTHON_DOWNLOADS=never UV_PROJECT_ENVIRONMENT=/fedshop/.venv
COPY pyproject.toml uv.lock README.md ./
COPY fedshop/ fedshop/
RUN uv sync --frozen --no-dev

COPY experiments/bsbm/ experiments/bsbm/
RUN cd experiments/bsbm/discovery/tools/css && npm ci --omit=dev \
    && cd ../fragmenter && npm ci --omit=dev

# The proxy's control port (GET /stats, POST /reset, GET /health)
EXPOSE 3999
ENTRYPOINT []
CMD ["/fedshop/.venv/bin/fedshop-discovery", "--help"]
