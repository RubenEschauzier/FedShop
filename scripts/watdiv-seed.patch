+// WATDIV_SEED seeds both random generators and WATDIV_TODAY (YYYY-MM-DD) ends the date ranges a template
+// leaves open, so that a run is reproducible; without them, the clock and today's date (upstream behaviour).
+static unsigned watdiv_seed(){
+    const char * seed = getenv("WATDIV_SEED");
+    return seed ? static_cast<unsigned> (strtoul(seed, NULL, 10)) : static_cast<unsigned> (time(0));
+}
+
+static boost::gregorian::date watdiv_today(){
+    const char * today = getenv("WATDIV_TODAY");
+    return today ? boost::gregorian::from_simple_string(today) : boost::posix_time::second_clock::local_time().date();
+}
+
